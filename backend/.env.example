# Copy to .env and adjust before starting the backend in production.
# The app reads these via os.getenv() with sensible defaults.

# Comma-separated list of allowed CORS origins.
# Use * to allow all (fine when Nginx is the only entry point).
CORS_ORIGINS=*

# Secure backend AI configuration for Location Analysis.
# Pick one provider and keep the API key on the server only.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Claude API — now used ONLY for the optional non-English clause translation step.
# (PDF lease extraction on upload is handled by the lease_abstraction_xts engine below.)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── lease_abstraction_xts extraction engine (app/services/lease_abstraction_xts) ────────────
# Reuses OPENAI_API_KEY / GEMINI_API_KEY above. Keys are required for upload extraction.
# NOTE: GEMINI_MODEL above is a GLOBAL override for the engine and would disable its hybrid
# routing — the adapter (lease_extractor_xts.py) hides GEMINI_MODEL during extraction, so the
# per-pass models below are always used. Leave these unset to use the engine defaults.
GEMINI_MODEL_QUALITY=gemini-3.5-flash
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
OPENAI_MODEL_CONTACTS=gpt-5-mini
OPENAI_MODEL_EXPENSES=gpt-5-mini

# OCR for scanned PDFs (Tesseract + Poppler). Auto-detected on PATH on macOS/Linux — only set
# these if the binaries are not on PATH (e.g. Windows):
#   macOS:  brew install tesseract poppler
#   Debian: apt-get install -y tesseract-ocr poppler-utils
TESSERACT_CMD=
POPPLER_PATH=

# ── Postgres-backed auth (organisations/users/roles/sessions/audit_logs) ───────────
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/LeaseArc
SESSION_TTL_HOURS=24
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
